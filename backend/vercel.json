{
  "version": 2,
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api/index.py"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/docs",
      "destination": "/api/index.py"
    },
    {
      "source": "/openapi.json",
      "destination": "/api/index.py"
    },
    {
      "source": "/redoc",
      "destination": "/api/index.py"
    },
    {
      "source": "/landing/(.*)",
      "destination": "/static/landing/$1"
    },
    {
      "source": "/landing",
      "destination": "/static/landing/index.html"
    },
    {
      "source": "/dashboard/(.*)",
      "destination": "/static/dashboard/$1"
    },
    {
      "source": "/dashboard",
      "destination": "/static/dashboard/index.html"
    },
    {
      "source": "/",
      "destination": "/static/landing/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index.py"
    }
  ]
}
