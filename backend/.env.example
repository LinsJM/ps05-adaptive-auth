# ========================================================
# Team Dignitas - Backend Environment Configuration Template
# DO NOT COMMIT THE ACTUAL .env FILE TO GIT!
# Copy this file to .env:
#   PowerShell: Copy-Item .env.example .env
# ========================================================

# Generate your own unique SECRET_KEY locally using:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_your_generated_64_character_hex_secret

# JWT Configuration
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Application Environment (development / production)
ENVIRONMENT=development
PORT=8000
HOST=127.0.0.1

# Database Configuration (SQLite default for local dev)
DATABASE_URL=sqlite:///./adaptive_auth.db
